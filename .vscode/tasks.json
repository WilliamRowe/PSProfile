
{ 
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install Profile",
            "detail": "Install profile.ps1 from current user workspace ",
            "type": "shell",
            "command": "${workspaceFolder}\\install.ps1",
            "runOptions": {
                "runOn": "folderOpen"
            },
            "group": {
                    "kind": "build",
                    "isDefault": true
            },
            "presentation": {
                "focus": true,
                "panel": "new",
                "reveal": "always",
                "clear": false
            }
        }
    ]

}
